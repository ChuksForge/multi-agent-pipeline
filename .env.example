# ─── LLM Providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ─── Model Configuration ──────────────────────────────────────────────────────
# Orchestrator / Planner: high-reasoning model
ORCHESTRATOR_MODEL=claude-sonnet-4-20250514
PLANNER_MODEL=claude-sonnet-4-20250514

# Sub-agents: fast, cheap execution model
ETL_AGENT_MODEL=claude-haiku-4-5-20251001
ANALYSIS_AGENT_MODEL=claude-haiku-4-5-20251001
REPORT_AGENT_MODEL=claude-haiku-4-5-20251001

# Fallback model when complexity=high
FALLBACK_MODEL=claude-sonnet-4-20250514

# ─── Pipeline Settings ────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0          # seconds (exponential: 2^attempt)
MAX_AGENT_TIMEOUT=120           # seconds per agent
PIPELINE_MAX_ROWS=500000        # DuckDB row limit (override per task)
SAMPLE_RATIO_ON_OOM=0.10        # fraction to use on memory error fallback

# ─── Data Paths ───────────────────────────────────────────────────────────────
DATA_DIR=data
OUTPUTS_DIR=data/outputs

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                 # json | console
COST_LOG_PATH=data/outputs/cost_log.jsonl

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
